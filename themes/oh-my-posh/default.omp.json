{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#61AFEF",
          "properties": {
            "style": "folder"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#98C379",
          "properties": {
            "fetch_status": true
          },
          "template": "{{ .HEAD }}{{ if .Working.Changed }} *{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#E5C07B",
          "template": "❯"
        }
      ]
    }
  ]
}
