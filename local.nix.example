# Copy this file to ~/.config/workspaces-host/local.nix and edit it - do
# NOT put it inside this repository. It's the one supported place for
# personal overrides (git identity, real secrets declarations, tool
# preferences), read automatically by every profile if it exists there.
# Because it lives outside this repo entirely, `git pull`/
# `workspaces-host-update` can never touch it or conflict with it -
# see README's "Updating your Git identity, and other secrets, from the
# CLI" section.
{
  # Your actual git identity (home/git.nix's defaults are placeholders
  # meant to be overridden exactly like this, not hand-edited in place).
  programs.git.userName = "Your Name";
  programs.git.userEmail = "you@example.com";

  # Real secrets go here too, once you've encrypted them - see README's
  # "GitHub/GitLab tokens, and other secrets that expire" section. This
  # is commented out; uncomment once github-token.enc.yaml sits next to
  # this file (~/.config/workspaces-host/github-token.enc.yaml). A bare
  # `path` like this one is scoped per-project via direnv, not ambient.
  # workspacesHost.secrets.github-token = {
  #   sopsFile = ./github-token.enc.yaml;
  #   path = "github-token";
  # };

  # An AI harness credential (Claude Code, Codex, Gemini CLI, aider, ...)
  # instead wants a `path` under "env/" - that convention auto-exports it
  # into every interactive shell, not just one project. See README's
  # "Setting up AI harness credentials" section.
  # workspacesHost.secrets.anthropic-key = {
  #   sopsFile = ./anthropic-key.enc.yaml;
  #   path = "env/ANTHROPIC_API_KEY";
  # };
}
