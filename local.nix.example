# Copy this file to ~/.config/workspaces-host/local.nix and edit it - do
# NOT put it inside this repository. It's the one supported place for
# advanced, Nix-level personal overrides (tool preferences, persona
# tweaks, extra packages), read automatically by every profile if it
# exists there. Because it lives outside this repo entirely, `git pull`/
# `workspaces-host-update` can never touch it or conflict with it.
#
# For the common case - your git name/email, GitHub/GitLab tokens, AI
# harness API keys - you almost certainly want
# ~/.config/workspaces-host/credentials instead (see credentials.example
# and README's "Setting up your credentials" section): a plain
# `KEY=value` file, no Nix syntax, that `workspaces-host-update` reads
# and wires up for you. This file is for going beyond that.
{
  # Nix-level overrides go here, e.g. an extra package or a tool
  # preference this repo doesn't already provide a knob for.
  # home.packages = [ pkgs.ripgrep ];

  # Advanced: a sops-encrypted secret, for anyone who specifically wants
  # field-level encryption at rest for a given credential (most people
  # don't need this - ~/.config/workspaces-host/credentials, protected
  # by ordinary file permissions like ~/.ssh or ~/.aws/credentials, is
  # the recommended default). See home/secrets.nix and README's
  # "Advanced: encrypting a secret at rest with sops" section.
  # workspacesHost.secrets.github-token = {
  #   sopsFile = ./github-token.enc.yaml;
  #   path = "env/GITHUB_TOKEN";
  # };
}
