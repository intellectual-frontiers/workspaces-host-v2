#!/bin/sh
# doctor: a slim health check for a workspaces-host-v2 provisioned
# environment. Prints one PASS/WARN/FAIL line per check; exits non-zero
# only if something FAILs (a WARN is informational, e.g. "you haven't set
# your git identity yet" rather than "the environment is broken").
set -u

FAILED=0

pass() { printf 'PASS  %s\n' "$1"; }
warn() { printf 'WARN  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; FAILED=1; }

check_cmd() {
    name="$1"
    label="${2:-$name}"
    if command -v "$name" >/dev/null 2>&1; then
        pass "$label is on PATH ($(command -v "$name"))"
    else
        fail "$label is NOT on PATH"
    fi
}

echo "workspaces-host doctor"
echo "======================"

echo
echo "-- Nix --"
if command -v nix >/dev/null 2>&1; then
    pass "nix is on PATH ($(nix --version 2>/dev/null | head -1))"
    if nix show-config 2>/dev/null | grep -q "experimental-features.*nix-command" && \
       nix show-config 2>/dev/null | grep -q "experimental-features.*flakes"; then
        pass "nix-command and flakes experimental features are enabled"
    else
        fail "nix-command/flakes experimental features are not both enabled (see README's install instructions)"
    fi
else
    fail "nix is NOT on PATH - none of the checks below can work without it"
fi

check_cmd home-manager

echo
echo "-- Shell / prompt / direnv --"
check_cmd fish
check_cmd oh-my-posh
check_cmd direnv
if command -v direnv >/dev/null 2>&1; then
    if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/direnv/lib/hm-nix-direnv.sh" ]; then
        pass "nix-direnv integration file present"
    else
        warn "nix-direnv integration file not found (did home-manager switch run?)"
    fi
fi

echo
echo "-- Git --"
check_cmd git
if command -v git >/dev/null 2>&1; then
    email=$(git config --get user.email 2>/dev/null || true)
    case "$email" in
    "")
        warn "git user.email is not set"
        ;;
    *@example.invalid)
        warn "git user.email is still the placeholder ($email) - see README's 'Updating your Git identity' section"
        ;;
    *)
        pass "git user.email is set ($email)"
        ;;
    esac
fi

echo
echo "-- Local configuration override (~/.config/workspaces-host/local.nix) --"
if [ -f "$HOME/.config/workspaces-host/local.nix" ]; then
    pass "~/.config/workspaces-host/local.nix exists (personal overrides live outside this repo, safe from every sync)"
else
    warn "~/.config/workspaces-host/local.nix not found - see README's 'Updating your Git identity, and other secrets, from the CLI' section; local.nix.example in this repo shows the format"
fi

echo
echo "-- GitHub/GitLab authentication --"
check_cmd gh
if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
        pass "gh is authenticated"
    else
        warn "gh is not authenticated - run 'gh auth login' (see README's 'GitHub/GitLab tokens' section for a non-interactive, token-based alternative)"
    fi
fi
check_cmd glab
if command -v glab >/dev/null 2>&1; then
    if glab auth status >/dev/null 2>&1; then
        pass "glab is authenticated"
    else
        warn "glab is not authenticated - run 'glab auth login' if you use GitLab"
    fi
fi

echo
echo "-- Common pitfalls (SSH, WSL, disk, locale, plaintext creds) --"

if [ -d "$HOME/.ssh" ]; then
    ssh_dir_perm=$(stat -c '%a' "$HOME/.ssh" 2>/dev/null || stat -f '%Lp' "$HOME/.ssh" 2>/dev/null || echo '?')
    if [ "$ssh_dir_perm" = "700" ]; then
        pass "~/.ssh exists with mode 700"
    else
        warn "~/.ssh exists but mode is $ssh_dir_perm, not 700 - ssh may refuse to use it (chmod 700 ~/.ssh)"
    fi
    found_key=0
    for key in "$HOME"/.ssh/id_*; do
        [ -f "$key" ] || continue
        case "$key" in
        *.pub) continue ;;
        esac
        found_key=1
        key_perm=$(stat -c '%a' "$key" 2>/dev/null || stat -f '%Lp' "$key" 2>/dev/null || echo '?')
        if [ "$key_perm" = "600" ] || [ "$key_perm" = "400" ]; then
            pass "$(basename "$key") exists with mode $key_perm"
        else
            warn "$(basename "$key") exists but mode is $key_perm, not 600 - ssh will refuse to use it (chmod 600 $key)"
        fi
    done
    [ "$found_key" = "1" ] || warn "no SSH private key found in ~/.ssh (id_ed25519, id_rsa, ...) - 'ssh-keygen -t ed25519' if you use SSH-based git remotes"
else
    warn "~/.ssh does not exist - 'ssh-keygen -t ed25519' if you use SSH-based git remotes"
fi

if grep -qi microsoft /proc/version 2>/dev/null; then
    case "$HOME" in
    /mnt/*)
        warn "\$HOME ($HOME) is under /mnt - that's the Windows filesystem from inside WSL, which is much slower and has permissions quirks; keep your files on the Linux filesystem (e.g. under ~) instead"
        ;;
    *)
        pass "\$HOME is on the Linux filesystem, not a slower /mnt/* Windows mount"
        ;;
    esac
fi

if command -v df >/dev/null 2>&1; then
    avail_kb=$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    case "$avail_kb" in
    '' | *[!0-9]*) ;;
    *)
        if [ "$avail_kb" -lt 2097152 ]; then
            warn "less than 2 GiB free on the filesystem holding \$HOME - if /nix is on the same disk, try 'nix-collect-garbage -d'"
        else
            pass "disk space looks fine ($((avail_kb / 1048576)) GiB+ free)"
        fi
        ;;
    esac
fi

if command -v locale >/dev/null 2>&1 && locale 2>&1 | grep -qi "cannot set"; then
    warn "locale is misconfigured (locale(1) reports it cannot set LC_*) - common on a fresh Debian/WSL install; 'sudo apt install -y locales && sudo dpkg-reconfigure locales', or add 'export LANG=C.UTF-8' to your shell config"
else
    pass "locale looks configured correctly"
fi

if [ -f "$HOME/.netrc" ]; then
    netrc_perm=$(stat -c '%a' "$HOME/.netrc" 2>/dev/null || stat -f '%Lp' "$HOME/.netrc" 2>/dev/null || echo '?')
    if [ "$netrc_perm" != "600" ]; then
        warn "~/.netrc exists with mode $netrc_perm, not 600 - it likely holds plaintext credentials readable by others (chmod 600 ~/.netrc); prefer 'gh auth login' or README's sops+direnv pattern instead"
    else
        warn "~/.netrc exists - if it holds real credentials, prefer 'gh auth login' or README's sops+direnv pattern over a plaintext credentials file"
    fi
fi

current_umask=$(umask)
case "$current_umask" in
0000 | 000)
    warn "umask is $current_umask (new files are world-writable by default) - add 'umask 022' to your shell config"
    ;;
*)
    pass "umask is $current_umask"
    ;;
esac

if command -v docker >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ]; then
        pass "running as root (docker group membership doesn't apply)"
    elif id -nG 2>/dev/null | grep -qw docker; then
        pass "you're in the 'docker' group (docker commands don't need sudo)"
    else
        warn "docker is installed but you're not in the 'docker' group - 'sudo usermod -aG docker \$USER' then log out and back in avoids needing sudo for every docker command"
    fi
fi

echo
echo "-- AI harness CLIs & credentials --"
check_ai_cli() {
    cli="$1"
    label="$2"
    key_vars="$3"
    if ! command -v "$cli" >/dev/null 2>&1; then
        warn "$label ($cli) is not installed - see README's 'Setting up AI harness credentials' section"
        return
    fi
    pass "$label is on PATH ($(command -v "$cli"))"
    for var in $key_vars; do
        eval "val=\${$var:-}"
        if [ -n "$val" ]; then
            pass "$label: \$$var is set"
            return
        fi
    done
    warn "$label is installed but none of ($key_vars) is set - either export one via local.nix (see README) or use the CLI's own 'login' command"
}
check_ai_cli claude "Claude Code" "ANTHROPIC_API_KEY"
check_ai_cli codex "OpenAI Codex CLI" "OPENAI_API_KEY"
check_ai_cli gemini "Gemini CLI" "GEMINI_API_KEY GOOGLE_API_KEY"
check_ai_cli aider "aider" "ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY"
if command -v gh >/dev/null 2>&1; then
    if gh extension list 2>/dev/null | grep -qi copilot; then
        pass "GitHub Copilot CLI extension is installed (gh extension list)"
    else
        warn "GitHub Copilot CLI extension not installed - 'gh extension install github/gh-copilot' if you want it"
    fi
fi

echo
echo "-- Ported CLI tools (home.packages) --"
for c in semtag mgitstatus mgit git-standup specify backlog scaffold-agent-harness sensitivectl pgpass gitleaks workspaces-host-update git-extras git-xargs; do
    check_cmd "$c"
done

echo
echo "-- Sandbox sync (workspaces-host-update) --"
if [ -n "${WORKSPACES_HOST_REPO:-}" ]; then
    if [ -d "$WORKSPACES_HOST_REPO/.git" ]; then
        pass "\$WORKSPACES_HOST_REPO ($WORKSPACES_HOST_REPO) is a git clone - 'workspaces-host-update' will work"
    else
        warn "\$WORKSPACES_HOST_REPO ($WORKSPACES_HOST_REPO) is not a git clone yet - clone workspaces-host-v2 there, or override the variable"
    fi
else
    warn "\$WORKSPACES_HOST_REPO is not set (did home-manager switch run?)"
fi

echo
echo "-- Workspace repo management (~/workspaces, mgit) --"
if [ -d "$HOME/workspaces" ]; then
    pass "~/workspaces exists"
    if [ -f "$HOME/workspaces/mgit.json" ]; then
        pass "~/workspaces/mgit.json exists (edit it to declare repos, then run 'mgit ensure')"
    else
        warn "~/workspaces/mgit.json not found (did home-manager switch run?)"
    fi
else
    warn "~/workspaces does not exist yet (did home-manager switch run?)"
fi

echo
echo "-- Compliance & observability tooling --"
if [ "$(uname -s)" = "Linux" ]; then
    check_cmd osqueryi "osquery (osqueryi)"
else
    warn "osquery is Linux-only (nixpkgs meta.platforms) - not installed on $(uname -s)"
fi
check_cmd cnquery
check_cmd steampipe
check_cmd openobserve
if command -v surveilr >/dev/null 2>&1; then
    pass "surveilr is on PATH ($(command -v surveilr))"
else
    warn "surveilr is not on PATH (upstream only publishes x86_64-linux/x86_64-darwin release binaries - see pkgs/surveilr)"
fi

echo
echo "-- PostgreSQL credentials (~/.pgpass, ~/.psqlrc) --"
if [ -f "$HOME/.pgpass" ]; then
    perm=$(stat -c '%a' "$HOME/.pgpass" 2>/dev/null || stat -f '%Lp' "$HOME/.pgpass" 2>/dev/null || echo '?')
    if [ "$perm" = "600" ]; then
        pass "~/.pgpass exists with mode 600 (edit it to add connections, then use 'pgpass')"
    else
        warn "~/.pgpass exists but mode is $perm, not 600 (libpq/psql may ignore it - chmod 600 ~/.pgpass)"
    fi
else
    warn "~/.pgpass not found (did home-manager switch run?)"
fi
if [ -f "$HOME/.psqlrc" ]; then
    pass "~/.psqlrc exists"
else
    warn "~/.psqlrc not found (did home-manager switch run?)"
fi

echo
echo "-- Java toolchain --"
check_cmd java
check_cmd mvn
if command -v java >/dev/null 2>&1; then
    pass "java $(java -version 2>&1 | head -1)"
fi
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    pass "JAVA_HOME is set and valid ($JAVA_HOME)"
else
    warn "JAVA_HOME is not set or not valid (did home-manager switch run?)"
fi

echo
echo "-- Optional: container tooling --"
if command -v docker >/dev/null 2>&1; then
    pass "docker is on PATH (needed to run packages.<system>.oci-image*)"
else
    warn "docker is not on PATH (only needed to run the OCI images this flake builds, not for the host profile itself)"
fi

echo
if [ "$FAILED" = "1" ]; then
    echo "doctor: one or more checks FAILED - see above"
    exit 1
else
    echo "doctor: all checks passed (WARNs, if any, are informational)"
    exit 0
fi
